{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": ["vite.config.ts", "playwright.config.ts", "tests/e2e/**/*"],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "lib": ["ES2024", "DOM"],
    "types": ["node"]
  }
}
